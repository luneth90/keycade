#!/usr/bin/python3
"""Read the active tmux server's documented prefix-table bindings safely.

`tmux list-keys` starts a server (and sources user configuration) when none is
running. This helper therefore calls `has-session` first and never calls
`show-options` or `list-keys` unless that read-only probe succeeds. Every
invocation also passes client ``-N`` so a server that disappears between the
probe and the query cannot be started as a side effect. The live
prefix/prefix2 values are returned with the documented table so the consumer
does not mix a running server's bindings with stale values from a file.
"""

from __future__ import annotations

import ctypes
import hashlib
import json
import os
import re
import selectors
import signal
import stat
import subprocess
import sys
import time
import unicodedata
from datetime import date
from typing import Any

SCHEMA_VERSION = 1
TMUX = "/usr/bin/tmux"
MAX_STDOUT = 512 * 1024
MAX_STDERR = 16 * 1024
MAX_BINDINGS = 512
MAX_LINES = 2048
TIMEOUT = 3.0
PR_SET_PDEATHSIG = 1
LIBC_PATH = "/usr/lib/libc.so.6"

_ACTIVE_CHILD: subprocess.Popen[bytes] | None = None

SHIFT, CTRL, ALT = 1, 4, 8
MODIFIERS = {"C": CTRL, "M": ALT, "S": "shift"}
NAMED = {
    "SPACE": "SPACE", "ENTER": "CR", "TAB": "TAB", "ESCAPE": "ESC", "BSPACE": "BS",
    "UP": "UP", "DOWN": "DOWN", "LEFT": "LEFT", "RIGHT": "RIGHT",
    "HOME": "HOME", "END": "END", "PPAGE": "PAGEUP", "NPAGE": "PAGEDOWN",
    "IC": "INSERT", "DC": "DEL",
}
DEVICE_SPECIAL = {"HOME", "END", "PAGEUP", "PAGEDOWN", "INSERT", "DEL"}
CATEGORY_NAMES = ["pane", "window", "session", "layout", "copy", "misc"]
CATEGORIES = [
    (r"\bpane\b", "pane"), (r"\bwindow\b", "window"),
    (r"\bsession\b|\bclient\b", "session"), (r"\blayout\b", "layout"),
    (r"paste|buffer|\bcopy\b", "copy"),
]


class Refused(Exception):
    pass


def trusted_command(path: str) -> str:
    try:
        info = os.stat(path)
    except OSError as error:
        raise OSError(f"{path} is unavailable") from error
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        raise OSError(f"{path} is not trusted")
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH) or not info.st_mode & stat.S_IXUSR:
        raise OSError(f"{path} is replaceable or not executable")
    return path


def has_controls(text: str) -> bool:
    return any(unicodedata.category(char).startswith("C") for char in text)


def sanitize_text(value: object, limit: int) -> str:
    text = unicodedata.normalize("NFC", str(value or ""))
    cleaned = "".join(" " if unicodedata.category(char).startswith("C") else char for char in text)
    return cleaned[:limit]


def _prepare_child() -> None:
    os.setsid()
    parent = os.getppid()
    try:
        libc = ctypes.CDLL(trusted_command(LIBC_PATH), use_errno=True)
        libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL)
    except OSError:
        return
    if os.getppid() != parent:
        os._exit(1)


def _kill_process_group(process: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def _terminate(_signum: int, _frame: Any) -> None:
    if _ACTIVE_CHILD is not None:
        _kill_process_group(_ACTIVE_CHILD)
    os._exit(143)


def install_signal_handlers() -> None:
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)


def command(command: list[str], stdout_limit: int) -> tuple[int, str]:
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            # PATH is only for anything tmux itself spawns; LC_ALL=C keeps the
            # documented listing in English so the parser is not locale-shifted.
            env={"PATH": "/usr/bin", "LC_ALL": "C"},
            preexec_fn=_prepare_child,
            close_fds=True,
        )
    except OSError as error:
        raise OSError(f"{' '.join(command)} failed: {error}") from error

    global _ACTIVE_CHILD
    _ACTIVE_CHILD = process
    streams = selectors.DefaultSelector()
    assert process.stdout is not None and process.stderr is not None
    streams.register(process.stdout, selectors.EVENT_READ, ("stdout", stdout_limit))
    streams.register(process.stderr, selectors.EVENT_READ, ("stderr", MAX_STDERR))
    buffers = {"stdout": bytearray(), "stderr": bytearray()}
    deadline = time.monotonic() + TIMEOUT
    try:
        while streams.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise OSError("tmux query timed out")
            events = streams.select(min(remaining, 0.1))
            if not events and process.poll() is not None:
                events = [(key, 0) for key in list(streams.get_map().values())]
            for key, _mask in events:
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    streams.unregister(key.fileobj)
                    continue
                name, limit = key.data
                buffers[name].extend(chunk)
                if len(buffers[name]) > limit:
                    raise OSError(f"tmux {name} exceeded its limit")
        return_code = process.wait(timeout=max(0.01, deadline - time.monotonic()))
    except Exception:
        _kill_process_group(process)
        raise
    finally:
        _ACTIVE_CHILD = None
        streams.close()
        process.stdout.close()
        process.stderr.close()
    return return_code, buffers["stdout"].decode("utf-8", errors="strict")


def parse_key(token: str) -> dict:
    if has_controls(token):
        raise Refused()
    mods = 0
    shifted = False
    while len(token) > 2 and token[1] == "-" and token[0].upper() in MODIFIERS:
        value = MODIFIERS[token[0].upper()]
        if value == "shift":
            shifted = True
        else:
            mods |= value
        token = token[2:]
    if not token:
        raise Refused()
    upper = token.upper()
    if upper in NAMED:
        if shifted:
            if NAMED[upper] == "TAB":
                raise Refused()
            mods |= SHIFT
        return {"mods": mods, "named": NAMED[upper]}
    if len(token) == 1 and not shifted:
        return {"mods": mods, "text": token.lower() if mods else token}
    raise Refused()


def description_key(desc: str) -> str:
    cleaned = sanitize_text(desc, 512)
    slug = re.sub(r"_+", "_", re.sub(r"[^a-z0-9]+", "_", cleaned.lower())).strip("_")
    return "packdesc_tmux_" + slug if slug else ""


def prefix_options(prefix: str, prefix2: str = "") -> dict[str, str]:
    """Order effective prefixes, preferring tmux's conflict-free C-b default."""
    candidates: list[tuple[str, dict]] = []
    for token in (prefix.strip(), prefix2.strip()):
        if not token or token.lower() == "none":
            continue
        if len(token) > 32 or has_controls(token):
            raise Refused()
        parsed = parse_key(token)
        if parsed.get("named") == "ESC":
            raise Refused()
        if not any(existing == parsed for _, existing in candidates):
            candidates.append((token, parsed))
    if not candidates:
        raise Refused()
    default = {"mods": CTRL, "text": "b"}
    for index, (_, parsed) in enumerate(candidates):
        if parsed == default:
            candidates.insert(0, candidates.pop(index))
            break
    options = {"prefix": candidates[0][0]}
    if len(candidates) > 1:
        options["prefix2"] = candidates[1][0]
    return options


def collect(listing: str, options: dict[str, str] | None = None) -> dict:
    bindings = []
    dropped: dict[str, int] = {}
    seen = set()

    def drop(reason: str) -> None:
        dropped[reason] = dropped.get(reason, 0) + 1

    lines = listing.splitlines()
    if len(lines) > MAX_LINES:
        dropped["too-many-lines"] = len(lines) - MAX_LINES
    for line in lines[:MAX_LINES]:
        if not line.strip():
            continue
        match = re.match(r"^(\S+)\s+(\S+)\s+(.+)$", line)
        if not match:
            drop("unreadable-line")
            continue
        prefix, key, raw_desc = match.group(1), match.group(2), match.group(3).strip()
        if not raw_desc or len(raw_desc) > 512:
            drop("missing-description")
            continue
        desc = sanitize_text(raw_desc, 512)
        if not desc.strip():
            drop("missing-description")
            continue
        if has_controls(prefix) or has_controls(key):
            drop("unreadable-notation")
            continue
        try:
            parse_key(prefix)  # validates the live listing's first column
            second = parse_key(key)
        except Refused:
            drop("unreadable-notation")
            continue
        steps = [{"option": "prefix"}, second]
        if any(step.get("named") == "ESC" for step in steps):
            drop("escape-in-answer")
            continue
        if any(step.get("named") in DEVICE_SPECIAL for step in steps):
            drop("device-special-key")
            continue
        local_id = "prefix/" + ("prefix" if key == prefix else key)
        if local_id in seen:
            drop("duplicate")
            continue
        if len(local_id) > 128 or len(bindings) >= MAX_BINDINGS:
            drop("limit")
            continue
        seen.add(local_id)
        lowered = desc.lower()
        category = "misc"
        for pattern, name in CATEGORIES:
            if re.search(pattern, lowered):
                category = name
                break
        bindings.append({
            "localId": local_id, "context": "prefix", "notation": "prefix " + key,
            "steps": steps,
            "alternates": [[{"option": "prefix2"}, second]],
            "category": category, "descKey": description_key(desc), "desc": desc,
            "extras": [],
        })
    return {
        "schemaVersion": 1, "profile": "tmux", "judgeMode": "text",
        "contexts": ["prefix"], "extras": [],
        "options": options or {},
        "categories": [name for name in CATEGORY_NAMES
                       if any(entry["category"] == name for entry in bindings)],
        "provenance": {
            "upstream": "tmux", "authority": "active tmux server: show-options + list-keys",
            "source": {"url": "local tmux server", "commit": "", "tag": "live",
                       "date": date.today().isoformat(),
                       "checksum": hashlib.sha256(listing.encode()).hexdigest()},
            "generatedAt": date.today().isoformat(), "generator": "bin/tmux-keys-json@1",
        },
        "dropped": dropped, "bindings": bindings,
    }


def unavailable(reason: str) -> dict:
    return {"schemaVersion": SCHEMA_VERSION, "profile": "tmux",
            "available": False, "reason": sanitize_text(reason, 128)}


def main() -> None:
    try:
        tmux = trusted_command(TMUX)
        # Client -N: never start a server. list-keys' own -N is the documented
        # table; the two flags are not the same option.
        status, _ = command([tmux, "-N", "has-session"], 4096)
        if status != 0:
            payload = unavailable("no running tmux server")
        else:
            prefix_status, prefix = command(
                [tmux, "-N", "show-options", "-gv", "prefix"], 4096)
            prefix2_status, prefix2 = command(
                [tmux, "-N", "show-options", "-gv", "prefix2"], 4096)
            status, listing = command(
                [tmux, "-N", "list-keys", "-N", "-T", "prefix"], MAX_STDOUT)
            if prefix_status != 0 or not prefix.strip():
                payload = unavailable("tmux prefix could not be read")
            elif status != 0 or not listing.strip():
                payload = unavailable("tmux key table could not be read")
            else:
                options = prefix_options(prefix, prefix2 if prefix2_status == 0 else "")
                payload = collect(listing, options)
                payload["available"] = bool(payload["bindings"])
    except Exception as error:  # one bounded record, never a traceback
        payload = unavailable(type(error).__name__)
    sys.stdout.write(json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    install_signal_handlers()
    main()
