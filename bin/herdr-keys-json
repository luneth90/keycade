#!/usr/bin/python3
"""Emit the herdr keybindings this machine actually has.

herdr is Omarchy's terminal multiplexer, and Omarchy ships a tool that already
resolves its bindings:

    omarchy-menu-herdr-keybindings --print

That tool runs `herdr --default-config` - the vendor binary printing its own
defaults - and merges the user's `config.toml` over it with awk. It executes
none of the user's code, it lives at a fixed root-owned path, and its output is
plain text with the prefix already resolved to whatever this machine set. That
puts it in the same trust class as `hyprctl binds`, which is why this ground
reads the machine rather than shipping a table.

So there is no prefix setting here and no packaged fallback: if the listing
cannot be read, the ground has nothing to teach and says so. A guessed prefix
would make every card wrong in a way nobody could see.
"""

from __future__ import annotations

import argparse
import ctypes
import json
import os
import re
import selectors
import signal
import stat
import subprocess
import sys
import time
import unicodedata
from typing import Any

SCHEMA_VERSION = 1
LISTING_COMMAND = "/usr/share/omarchy/bin/omarchy-menu-herdr-keybindings"
COMMAND_TIMEOUT_SECONDS = 5.0
MAX_STDOUT_BYTES = 256 * 1024
MAX_LINES = 512
MAX_BINDINGS = 512
MAX_DESC_CHARS = 512
MAX_LOCAL_ID_CHARS = 128
MAX_PAYLOAD_BYTES = 512 * 1024
READ_SIZE = 64 * 1024
PR_SET_PDEATHSIG = 1
# Absolute so no library this keep-loaded path relies on is resolved by the
# dynamic loader's ambient search, and checked before it is opened: an absolute
# path says nothing about who may replace the file behind it.
LIBC_PATH = "/usr/lib/libc.so.6"

_ACTIVE_CHILD: subprocess.Popen[bytes] | None = None

# Mirrors lib/TextKey.js, which judges what this produces.
SHIFT = 1
CTRL = 4
ALT = 8
SUPER = 64
MODIFIERS = {"CTRL": CTRL, "ALT": ALT, "SUPER": SUPER, "SHIFT": "shift"}

NAMED = {
    "SPACE": "SPACE", "ENTER": "CR", "RETURN": "CR", "TAB": "TAB", "ESC": "ESC",
    "ESCAPE": "ESC", "BACKSPACE": "BS", "UP": "UP", "DOWN": "DOWN", "LEFT": "LEFT",
    "RIGHT": "RIGHT", "HOME": "HOME", "END": "END", "PAGEUP": "PAGEUP",
    "PAGEDOWN": "PAGEDOWN", "INSERT": "INSERT", "DELETE": "DEL",
}

# A compact keyboard is not guaranteed to carry these - the same rule every
# other ground applies.
DEVICE_SPECIAL = {"HOME", "END", "PAGEUP", "PAGEDOWN", "INSERT", "DEL"}

CATEGORIES = ["pane", "tab", "workspace", "copy", "session", "misc"]

CATEGORY_WORDS = [
    (r"\bpane\b|sidebar|scrollback", "pane"),
    (r"\btab\b", "tab"),
    (r"workspace|worktree", "workspace"),
    (r"copy|paste|clipboard", "copy"),
    (r"detach|session|client|settings|config|help|notification|goto", "session"),
]


class Rejected(Exception):
    """The line names something no card can ask for."""


def has_controls(text: str) -> bool:
    return any(unicodedata.category(char).startswith("C") for char in text)


def sanitize_text(value: object, limit: int) -> str:
    text = unicodedata.normalize("NFC", str(value or ""))
    cleaned = "".join(" " if unicodedata.category(char).startswith("C") else char for char in text)
    return cleaned[:limit]


def trusted_command(path: str) -> str:
    """Return ``path`` only when it is a root-owned, non-writable executable.

    Commands are addressed by absolute path so nothing is resolved through the
    ambient ``PATH`` of the long-lived shell process that hosts the plugin.
    An absolute path alone still trusts whoever can write the file behind it.
    """
    try:
        info = os.stat(path)
    except OSError as error:
        raise OSError(f"{path} is unavailable") from error
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
        raise OSError(f"{path} is not trusted")
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH) or not info.st_mode & stat.S_IXUSR:
        raise OSError(f"{path} is replaceable or not executable")
    return path


def _prepare_child() -> None:
    # Own session so this helper can signal the listing's whole group, plus a
    # kernel death signal so an immediately killed helper cannot leave the
    # listing (and herdr | awk under it) running.
    os.setsid()
    parent = os.getppid()
    try:
        libc = ctypes.CDLL(trusted_command(LIBC_PATH), use_errno=True)
        libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL)
    except OSError:
        return
    if os.getppid() != parent:
        os._exit(1)


def _kill_process_group(process: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def _terminate(_signum: int, _frame: Any) -> None:
    if _ACTIVE_CHILD is not None:
        _kill_process_group(_ACTIVE_CHILD)
    os._exit(143)


def install_signal_handlers() -> None:
    signal.signal(signal.SIGTERM, _terminate)
    signal.signal(signal.SIGHUP, _terminate)


def parse_chord(text: str) -> dict:
    """"CTRL + ALT + LEFT" as one step."""
    if has_controls(text):
        raise Rejected("contains control characters")
    mods = 0
    shifted = False
    parts = [part.strip() for part in text.split("+") if part.strip()]
    if not parts:
        raise Rejected("empty chord")
    for part in parts[:-1]:
        name = part.upper()
        if name not in MODIFIERS:
            raise Rejected(f"unknown modifier {part!r}")
        value = MODIFIERS[name]
        if value == "shift":
            shifted = True
        else:
            mods |= value
    key = parts[-1]
    upper = key.upper()
    if upper in NAMED:
        if shifted:
            # A named key has no character for Shift to be folded into, so it
            # is a modifier here like any other - Shift+Left is its own chord.
            # Tab is the exception: Qt reports Backtab and Tab as one key, so
            # the two would judge the same and it is refused instead.
            if NAMED[upper] == "TAB":
                raise Rejected("Shift on Tab cannot be told from Tab")
            mods |= SHIFT
        return {"mods": mods, "named": NAMED[upper]}
    if len(key) != 1:
        raise Rejected(f"unknown key {key!r}")
    if shifted:
        if key.upper() == key.lower():
            raise Rejected("Shift on a character that does not shift")
        return {"mods": mods, "text": key.upper()}
    # The listing prints every key upper-cased for display - herdr's own config
    # says `settings = "prefix+s"` where the listing shows "PREFIX + S". Taking
    # that literally would ask for Shift on every letter, because Shift is
    # folded into the character in this judging mode. A letter the listing did
    # not name SHIFT on is the lower-case key.
    if key.isalpha():
        return {"mods": mods, "text": key.lower()}
    return {"mods": mods, "text": key}


def category_for(desc: str) -> str:
    lowered = desc.lower()
    for pattern, name in CATEGORY_WORDS:
        if re.search(pattern, lowered):
            return name
    return "misc"


def description_key(desc: str) -> str:
    cleaned = sanitize_text(desc, MAX_DESC_CHARS)
    slug = re.sub(r"_+", "_", re.sub(r"[^a-z0-9]+", "_", cleaned.lower())).strip("_")
    return "herdrdesc_" + slug if slug else ""


def run_listing() -> str:
    """The vendor's own listing, by a trusted absolute path.

    HOME is on the rebuilt environment because the listing tool locates
    ``~/.config/herdr/config.toml`` from it. Nothing else is inherited.
    """
    command = [trusted_command(LISTING_COMMAND), "--print"]
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            env={"PATH": "/usr/bin", "HOME": os.environ.get("HOME", "")},
            preexec_fn=_prepare_child,
            close_fds=True,
        )
    except OSError as error:
        raise RuntimeError(f"listing could not start: {error}") from error

    global _ACTIVE_CHILD
    _ACTIVE_CHILD = process
    streams = selectors.DefaultSelector()
    assert process.stdout is not None
    streams.register(process.stdout, selectors.EVENT_READ)
    deadline = time.monotonic() + COMMAND_TIMEOUT_SECONDS
    chunks = bytearray()
    try:
        while streams.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RuntimeError("listing exceeded its deadline")
            events = streams.select(min(remaining, 0.1))
            if not events and process.poll() is not None:
                events = [(key, 0) for key in list(streams.get_map().values())]
            for key, _mask in events:
                chunk = os.read(key.fd, READ_SIZE)
                if not chunk:
                    streams.unregister(key.fileobj)
                    continue
                chunks.extend(chunk)
                if len(chunks) > MAX_STDOUT_BYTES:
                    raise RuntimeError("listing exceeded its limit")
        return_code = process.wait(timeout=max(0.01, deadline - time.monotonic()))
    except Exception:
        _kill_process_group(process)
        raise
    finally:
        _ACTIVE_CHILD = None
        streams.close()
        process.stdout.close()

    if return_code != 0:
        raise RuntimeError(f"listing exited with {return_code}")
    return chunks.decode("utf-8", "replace")


def snapshot(text: str) -> dict[str, Any]:
    prefix: dict | None = None
    bindings: list[dict] = []
    dropped: dict[str, int] = {}
    seen: set[str] = set()

    def drop(reason: str) -> None:
        dropped[reason] = dropped.get(reason, 0) + 1

    for line in text.splitlines()[:MAX_LINES]:
        if "→" not in line:
            continue
        combo, _, raw_desc = line.partition("→")
        combo, raw_desc = combo.strip(), raw_desc.strip()
        if len(raw_desc) > MAX_DESC_CHARS:
            drop("limit")
            continue
        desc = sanitize_text(raw_desc, MAX_DESC_CHARS).strip()

        # The first line declares what the prefix resolved to on this machine.
        if combo == "PREFIX":
            try:
                prefix = parse_chord(raw_desc)
            except Rejected:
                drop("unreadable-prefix")
            continue

        if not desc:
            drop("missing-description")
            continue

        if has_controls(combo):
            drop("unreadable-notation")
            continue

        context = "default"
        if combo.startswith("NAVIGATE + "):
            # Navigate mode is a state you open first, so its keys are asked
            # with the mode named on the card rather than as a sequence.
            context, combo = "navigate", combo[len("NAVIGATE + "):]

        # "A / B" is one action reached two ways. Both are accepted: refusing a
        # spelling herdr itself accepts would be teaching something untrue.
        spellings = [part.strip() for part in combo.split(" / ") if part.strip()]
        if not spellings:
            drop("no-binding")
            continue
        chosen = spellings[0]

        # "1..9" abbreviates nine bindings; it is not a key anyone presses.
        if ".." in chosen:
            drop("range-notation")
            continue

        steps: list[dict] = []
        try:
            if chosen == "PREFIX" or chosen.startswith("PREFIX + "):
                if prefix is None:
                    drop("prefix-not-declared")
                    continue
                steps.append(dict(prefix))
                rest = chosen[len("PREFIX + "):] if chosen != "PREFIX" else ""
                if rest:
                    steps.append(parse_chord(rest))
            else:
                steps.append(parse_chord(chosen))
        except Rejected:
            drop("unreadable-notation")
            continue

        if any(step.get("named") == "ESC" for step in steps):
            drop("escape-in-answer")
            continue
        if any(step.get("named") in DEVICE_SPECIAL for step in steps):
            drop("device-special-key")
            continue

        # The other spellings, each read the same way and each dropped on its
        # own if it cannot be: one unreadable alternate must not cost the card.
        alternates = []
        for spelling in spellings[1:]:
            if ".." in spelling:
                continue
            try:
                if spelling == "PREFIX" or spelling.startswith("PREFIX + "):
                    if prefix is None:
                        continue
                    rest = spelling[len("PREFIX + "):] if spelling != "PREFIX" else ""
                    other = [dict(prefix)] + ([parse_chord(rest)] if rest else [])
                else:
                    other = [parse_chord(spelling)]
            except Rejected:
                drop("unreadable-alternate")
                continue
            if any(step.get("named") == "ESC" for step in other):
                continue
            if any(step.get("named") in DEVICE_SPECIAL for step in other):
                continue
            alternates.append(other)

        local_id = context + "/" + chosen
        if len(local_id) > MAX_LOCAL_ID_CHARS or len(bindings) >= MAX_BINDINGS:
            drop("limit")
            continue
        seen.add(local_id)
        key = description_key(desc)
        if not key:
            drop("missing-description")
            continue
        bindings.append({
            "localId": local_id,
            "context": context,
            "notation": chosen,
            "steps": steps,
            "alternates": alternates,
            "category": category_for(desc),
            "descKey": key,
            "desc": desc,
            "extras": [],
        })

    return {
        "schemaVersion": SCHEMA_VERSION,
        "profile": "herdr",
        "judgeMode": "text",
        "contexts": sorted({entry["context"] for entry in bindings}),
        "categories": [name for name in CATEGORIES
                       if any(entry["category"] == name for entry in bindings)],
        "extras": [],
        "prefix": prefix,
        "dropped": dict(sorted(dropped.items())),
        "bindings": bindings,
    }


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--listing", default=None,
                        help="read a saved listing instead of running the tool (tests)")
    arguments = parser.parse_args()

    try:
        if arguments.listing:
            with open(arguments.listing, encoding="utf-8") as handle:
                text = handle.read(MAX_STDOUT_BYTES + 1)
        else:
            text = run_listing()
        payload = snapshot(text)
        if not payload["bindings"]:
            raise RuntimeError("listing named no trainable binding")
    except Exception as error:  # noqa: BLE001 - one line out, never a traceback
        payload = {"schemaVersion": SCHEMA_VERSION, "type": "error",
                   "error": sanitize_text(type(error).__name__, 128)}

    line = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
    if len(line.encode("utf-8")) > MAX_PAYLOAD_BYTES:
        line = json.dumps({"schemaVersion": SCHEMA_VERSION, "type": "error",
                           "error": "payload exceeds its limit"})
    sys.stdout.write(line + "\n")


if __name__ == "__main__":
    install_signal_handlers()
    main()
